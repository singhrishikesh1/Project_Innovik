# VajraShield Environment Configuration

# Backend
PORT=5001
NODE_ENV=production
AI_SERVICE_URL=http://localhost:8001

# Database (Optional PostgreSQL / PostGIS connection pool)
# If omitted, platform runs with zero-dependency transactional in-memory / JSON persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vajrashield_db

# Frontend
VITE_API_URL=http://localhost:5001/api

# External Weather / Satellite APIs (Optional - platform uses resilient local fallbacks)
IMD_API_KEY=mock_imd_radar_key
COPERNICUS_API_USER=copernicus_demo
COPERNICUS_API_PASS=copernicus_demo
